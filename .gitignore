# 第三方被测样例（按 commit 锁定，本地克隆，不入库）
vendor/

# 本地工具链（.NET SDK、安装器等）
tools/

# Unity 生成物
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]serSettings/
*.csproj
*.sln

# .NET 生成物
bin/
obj/

# 运行产物
artifacts/
*.log

# 文档与笔记只在本地维护，不入库
docs/
notes/

# .NET 生成物（补充）
[Bb]in/
[Oo]bj/

# 本工程自己的项目文件不受 Unity 生成物规则影响
!src/**/*.csproj
!tests/**/*.csproj

# pigeon eval 的题目目录在每台主机上由 eval/generate-tasks.mjs 现场生成，含本机绝对路径
eval/tasks/

# Python 缓存（eval/inspect）
__pycache__/
.pytest_cache/
